DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# LLM configuration for "Use LLM" extraction feature
# Provider: anthropic | openai | gemini | openai-compatible
LLM_PROVIDER=anthropic

# Model name (must be supported by the selected provider)
# Examples: claude-sonnet-4-5, gpt-4.1, gemini-2.5-pro
LLM_MODEL=claude-sonnet-4-5

# API key — never log or expose this value
LLM_API_KEY=sk-...

# Optional base URL for openai-compatible providers (Groq, Together, OpenRouter, Ollama, etc.)
# Leave blank for OpenAI default or Anthropic/Gemini (they have fixed endpoints)
# LLM_BASE_URL=
