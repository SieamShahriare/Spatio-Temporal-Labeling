DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# LLM configuration for "Use LLM" extraction feature
# Provider: anthropic | openai | gemini | openai-compatible | openrouter
LLM_PROVIDER=anthropic

# Model name (must be supported by the selected provider)
# Examples: claude-sonnet-4-5, gpt-4.1, gemini-2.5-pro
LLM_MODEL=claude-sonnet-4-5

# API key — never log or expose this value
LLM_API_KEY=sk-...

# Optional base URL for openai-compatible providers (Groq, Together, Ollama, etc.)
# Not needed for openrouter; that provider uses https://openrouter.ai/api/v1 automatically.
# LLM_BASE_URL=
